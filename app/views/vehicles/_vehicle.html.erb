<div id="<%= dom_id vehicle %>">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-xl font-bold text-gray-900"><%= vehicle.name %></h2>
    <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-primary">
      <%= vehicle.vehicle_type.humanize %>
    </span>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-4 text-sm">
    <div>
      <dt class="text-muted font-medium">Make</dt>
      <dd class="mt-0.5"><%= vehicle.make %></dd>
    </div>

    <div>
      <dt class="text-muted font-medium">Model</dt>
      <dd class="mt-0.5"><%= vehicle.model %></dd>
    </div>

    <div>
      <dt class="text-muted font-medium">Year</dt>
      <dd class="mt-0.5"><%= vehicle.year %></dd>
    </div>

    <% if vehicle.trim.present? %>
      <div>
        <dt class="text-muted font-medium">Trim</dt>
        <dd class="mt-0.5"><%= vehicle.trim %></dd>
      </div>
    <% end %>

    <% if vehicle.color.present? %>
      <div>
        <dt class="text-muted font-medium">Color</dt>
        <dd class="mt-0.5"><%= vehicle.color %></dd>
      </div>
    <% end %>

    <% if vehicle.current_mileage.present? %>
      <div>
        <dt class="text-muted font-medium">Current mileage</dt>
        <dd class="mt-0.5"><%= number_with_delimiter(vehicle.current_mileage) %> mi</dd>
      </div>
    <% end %>

    <% if vehicle.vin.present? %>
      <div>
        <dt class="text-muted font-medium">VIN</dt>
        <dd class="mt-0.5 font-mono text-xs"><%= vehicle.vin %></dd>
      </div>
    <% end %>

    <% if vehicle.license_plate.present? %>
      <div>
        <dt class="text-muted font-medium">License plate</dt>
        <dd class="mt-0.5"><%= vehicle.license_plate %></dd>
      </div>
    <% end %>
  </div>

  <% if vehicle.notes.present? %>
    <div class="mt-6 pt-4 border-t border-border">
      <dt class="text-muted font-medium text-sm mb-1">Notes</dt>
      <dd class="text-sm whitespace-pre-line"><%= vehicle.notes %></dd>
    </div>
  <% end %>
</div>
