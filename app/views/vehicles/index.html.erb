<% content_for :title, "Vehicles" %>

<div class="flex items-center justify-between mb-8">
  <h1 class="text-2xl font-bold text-primary">Vehicles</h1>
  <%= link_to "New vehicle", new_vehicle_path,
      class: "inline-flex items-center gap-2 bg-primary text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-primary-light transition-colors" %>
</div>

<% if @vehicles.any? %>
  <div id="vehicles" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @vehicles.each do |vehicle| %>
      <%= link_to vehicle, class: "block bg-white rounded-lg border border-border shadow-sm hover:shadow-md transition-shadow p-5" do %>
        <div class="flex items-start justify-between mb-3">
          <h2 class="text-lg font-semibold text-gray-900"><%= vehicle.name %></h2>
          <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-primary">
            <%= vehicle.vehicle_type.humanize %>
          </span>
        </div>
        <p class="text-sm text-muted mb-1"><%= vehicle %></p>
        <% if vehicle.current_mileage.present? %>
          <p class="text-sm text-muted"><%= number_with_delimiter(vehicle.current_mileage) %> miles</p>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-16 bg-white rounded-lg border border-border">
    <p class="text-muted text-lg mb-4">No vehicles yet.</p>
    <%= link_to "Add your first vehicle", new_vehicle_path,
        class: "text-primary font-medium hover:text-primary-light transition-colors" %>
  </div>
<% end %>
