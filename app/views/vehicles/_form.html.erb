<%= form_with(model: vehicle, class: "space-y-6", data: { controller: "vin-decoder", vin_decoder_url_value: decode_vin_vehicles_path }) do |form| %>
  <% if vehicle.errors.any? %>
    <div class="px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-sm">
      <h2 class="font-medium text-danger mb-2">
        <%= pluralize(vehicle.errors.count, "error") %> prohibited this vehicle from being saved:
      </h2>
      <ul class="list-disc list-inside text-danger space-y-1">
        <% vehicle.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset class="space-y-4">
    <legend class="text-lg font-semibold text-gray-900">Basic info</legend>

    <div>
      <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :name, class: "w-full rounded-lg border border-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" %>
    </div>

    <div>
      <%= form.label :vin, "VIN", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <div class="flex gap-2">
        <%= form.text_field :vin, maxlength: 17, class: "flex-1 rounded-lg border border-border px-3 py-2 text-sm font-mono uppercase focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary",
            data: { vin_decoder_target: "vin" } %>
        <button type="button" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors cursor-pointer"
            data-vin-decoder-target="button" data-action="vin-decoder#decode">
          Decode VIN
        </button>
      </div>
      <p class="mt-1 text-sm text-danger" hidden data-vin-decoder-target="error"></p>
    </div>

    <div>
      <%= form.label :vehicle_type, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.select :vehicle_type, Vehicle.vehicle_types.keys.map { |t| [t.humanize, t] }, { prompt: "Select type" },
          class: "w-full rounded-lg border border-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary",
          data: { vin_decoder_target: "vehicleType" } %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <%= form.label :make, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :make, class: "w-full rounded-lg border border-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary",
            data: { vin_decoder_target: "make" } %>
      </div>

      <div>
        <%= form.label :model, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :model, class: "w-full rounded-lg border border-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary",
            data: { vin_decoder_target: "model" } %>
      </div>

      <div>
        <%= form.label :year, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :year, min: 1900, max: 2100, class: "w-full rounded-lg border border-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary",
            data: { vin_decoder_target: "year" } %>
      </div>
    </div>
  </fieldset>

  <fieldset class="space-y-4">
    <legend class="text-lg font-semibold text-gray-900">Details</legend>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= form.label :trim, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :trim, class: "w-full rounded-lg border border-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary",
            data: { vin_decoder_target: "trim" } %>
      </div>

      <div>
        <%= form.label :color, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :color, class: "w-full rounded-lg border border-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= form.label :license_plate, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :license_plate, class: "w-full rounded-lg border border-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" %>
      </div>

      <div>
        <%= form.label :current_mileage, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :current_mileage, min: 0, class: "w-full rounded-lg border border-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" %>
      </div>
    </div>
  </fieldset>

  <fieldset class="space-y-4">
    <legend class="text-lg font-semibold text-gray-900">Notes</legend>

    <div>
      <%= form.textarea :notes, rows: 4, class: "w-full rounded-lg border border-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" %>
    </div>
  </fieldset>

  <div>
    <%= form.submit class: "bg-primary text-white px-6 py-2.5 rounded-lg text-sm font-medium hover:bg-primary-light transition-colors cursor-pointer" %>
  </div>
<% end %>
