<div id="<%= dom_id service_record %>" class="flex items-start justify-between gap-4 py-4">
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2 mb-1">
      <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-primary">
        <%= service_record.service_type.humanize %>
      </span>
      <span class="text-sm text-muted"><%= service_record.performed_on.strftime("%b %-d, %Y") %></span>
    </div>
    <p class="text-sm font-medium text-gray-900"><%= service_record.description %></p>
    <div class="flex items-center gap-4 mt-1 text-xs text-muted">
      <% if service_record.mileage_at_service.present? %>
        <span><%= number_with_delimiter(service_record.mileage_at_service) %> mi</span>
      <% end %>
      <% if service_record.cost_cents.present? %>
        <span>$<%= number_with_precision(service_record.cost_dollars, precision: 2) %></span>
      <% end %>
      <% if service_record.shop_or_mechanic.present? %>
        <span><%= service_record.shop_or_mechanic %></span>
      <% end %>
    </div>
  </div>
  <div class="flex items-center gap-2 shrink-0">
    <%= link_to "View", vehicle_service_record_path(service_record.vehicle, service_record),
        class: "text-xs text-muted hover:text-primary transition-colors" %>
    <%= link_to "Edit", edit_vehicle_service_record_path(service_record.vehicle, service_record),
        class: "text-xs text-muted hover:text-primary transition-colors" %>
    <%= button_to "Delete", vehicle_service_record_path(service_record.vehicle, service_record), method: :delete,
        class: "text-xs text-muted hover:text-danger transition-colors cursor-pointer",
        data: { turbo_confirm: "Are you sure you want to delete this service record?" } %>
  </div>
</div>
