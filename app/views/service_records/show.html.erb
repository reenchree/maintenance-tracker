<% content_for :title, "#{@service_record.service_type.humanize} — #{@vehicle.name}" %>

<div class="mb-6">
  <%= link_to "\u2190 Back to #{@vehicle.name}", @vehicle,
      class: "text-sm text-muted hover:text-primary transition-colors" %>
</div>

<div class="bg-white rounded-lg border border-border shadow-sm p-6">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-xl font-bold text-gray-900"><%= @service_record.description %></h2>
    <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-primary">
      <%= @service_record.service_type.humanize %>
    </span>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-4 text-sm">
    <div>
      <dt class="text-muted font-medium">Date performed</dt>
      <dd class="mt-0.5"><%= @service_record.performed_on.strftime("%B %-d, %Y") %></dd>
    </div>

    <div>
      <dt class="text-muted font-medium">Vehicle</dt>
      <dd class="mt-0.5"><%= @vehicle %></dd>
    </div>

    <% if @service_record.mileage_at_service.present? %>
      <div>
        <dt class="text-muted font-medium">Mileage at service</dt>
        <dd class="mt-0.5"><%= number_with_delimiter(@service_record.mileage_at_service) %> mi</dd>
      </div>
    <% end %>

    <% if @service_record.cost_cents.present? %>
      <div>
        <dt class="text-muted font-medium">Cost</dt>
        <dd class="mt-0.5">$<%= number_with_precision(@service_record.cost_dollars, precision: 2) %></dd>
      </div>
    <% end %>

    <% if @service_record.shop_or_mechanic.present? %>
      <div>
        <dt class="text-muted font-medium">Shop / Mechanic</dt>
        <dd class="mt-0.5"><%= @service_record.shop_or_mechanic %></dd>
      </div>
    <% end %>
  </div>

  <% if @service_record.notes.present? %>
    <div class="mt-6 pt-4 border-t border-border">
      <dt class="text-muted font-medium text-sm mb-1">Notes</dt>
      <dd class="text-sm whitespace-pre-line"><%= @service_record.notes %></dd>
    </div>
  <% end %>
</div>

<div class="mt-6 flex items-center gap-4">
  <%= link_to "Edit", edit_vehicle_service_record_path(@vehicle, @service_record),
      class: "bg-primary text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-primary-light transition-colors" %>
  <%= button_to "Delete", vehicle_service_record_path(@vehicle, @service_record), method: :delete,
      class: "bg-danger text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-red-700 transition-colors cursor-pointer",
      data: { turbo_confirm: "Are you sure you want to delete this service record?" } %>
</div>
